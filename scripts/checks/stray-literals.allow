# The literals scripts/checks/stray-literals.sh reads as words that no
# reader sees as the library's text, each with the reason, and the files it
# does not cover.

skip crates/ferrohealth-ui/src/highlight/   # tokenizers: grammar keywords and the markup they write
skip crates/ferrohealth-ui/src/icon.rs      # the vendored Lucide outlines and their names
skip crates/ferrohealth-ui/src/i18n.rs      # the catalog mechanism: message ids and diagnostics

allow ^(ArrowUp|ArrowDown|ArrowLeft|ArrowRight|Home|End|Enter|Escape)$   # UI Events KeyboardEvent.key values
allow ^Ferro(BRIDGE|FED|EHR|TERM)$     # product names, the same in every language
allow ^Cadasto B\.V\.$                  # the maker's legal name
allow ^(start|middle|end)$              # SVG text-anchor keywords
allow ^<                                # SVG markup a chart writes as a string
allow ^M\{                              # SVG path data
allow ^(Zz|Tt )$                        # the bytes a timestamp parser accepts
allow ^\{\}T\{\}Z?$                     # the HTML machine form of a date-time
allow ^\{id\}-L                         # an editor line's id

# The gallery: the synthetic data it draws, and its server.
skip app/ferrohealth-ui-gallery/src/data.rs     # the synthetic rows and documents the gallery draws as data
skip app/ferrohealth-ui-gallery/src/server.rs   # the HTTP server: headers, policies, environment names, a malformed post's refusal
allow ^SYN-[0-9]+$                      # the gallery's synthetic codes
allow ^synthetic-node-[a-z]$            # a synthetic node's name, drawn as code
allow ^https?://                        # a URL
allow ^/[a-z_/]+$                       # a path, drawn as code
allow ^Practitioner/                    # a FHIR reference, the synthetic operator's
allow ^file-L$                          # an editor line's id prefix
allow ^[0-9]{4}-[0-9]{2}-[0-9]{2}T      # an RFC 3339 instant, drawn as data
allow ^2026-10-1\{index\}T              # the same, made per row
allow ^[0-9a-f]{8}-[0-9a-f-]+           # an identifier in the UUID form
allow ^0123456789ab$                    # a synthetic version hash
allow ^CARGO_PKG_VERSION$               # the environment variable Cargo sets
allow ^(GET|POST)$                      # an HTTP method
allow ^theme=\{\}&back=                 # a form body the theme toggle posts
