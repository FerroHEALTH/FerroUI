# The literals scripts/checks/stray-literals.sh reads as words that no
# reader sees as the library's text, each with the reason, and the files it
# does not cover.

skip crates/ferrohealth-ui/src/highlight/   # tokenizers: grammar keywords and the markup they write
skip crates/ferrohealth-ui/src/icon.rs      # the vendored Lucide outlines and their names
skip crates/ferrohealth-ui/src/i18n/        # the catalog mechanism: message ids and diagnostics

allow ^(ArrowUp|ArrowDown|ArrowLeft|ArrowRight|Home|End|Enter|Escape|Tab|PageUp|PageDown)$   # UI Events KeyboardEvent.key values
allow ^\(width                         # a CSS media query the browser code matches
allow ^(Esc|Space|Ctrl|Control|Shift|Alt|Meta)$  # a key as printed on its cap and as aria-keyshortcuts names it
allow ^Ctrl s$                          # a shortcut's keys, drawn as key caps
allow ^j k \| up down$                 # a shortcut's keys, drawn as key caps
allow ^(checkbox|radio|button|submit|reset|range|color|file|image)$   # the input types that take no typed text
allow ^Ferro(BRIDGE|FED|EHR|TERM|PIX)$ # product names, the same in every language
allow ^Cadasto B\.V\.$                  # the maker's legal name
allow ^(start|middle|end)$              # SVG text-anchor keywords
allow ^%2F$                             # a tree's path key: the percent-encoded separator inside a key
allow ^<                                # SVG markup a chart writes as a string
allow ^M\{                              # SVG path data
allow ^M-?[0-9][-0-9 .AHLVZ]*$          # the SVG path of a chart's point mark
allow ^(Zz|Tt )$                        # the bytes a timestamp parser accepts
allow ^\{\}T\{\}Z?$                     # the HTML machine form of a date-time
allow ^\{id\}-L                         # an editor line's id
allow ^(tbody|thead|tr\[data-key|a\[href\]) # the CSS selectors of the work-list's rows and controls, which the browser code reads
allow ^\\u\{2013\}$                     # the en dash an absent compare value draws, hidden from a reader beside its word
allow ^fui-mark-(error|warning) is-current$   # the classes of a marked line the cursor is on
allow ^fui-search-results is-(end|narrow)$   # the classes of a search panel opened from the field's end edge or as wide as the field
allow ^(Accept|Content-Type)$          # the HTTP header names the search's typeahead sends
allow ^input:checked, select,           # the CSS selector of a preference's chosen control, which the browser code focuses
allow ^(\.fui-tnode-info a|\.fui-topology-list \[role|a, button$|:scope > svg$)   # the CSS selectors of the topology's quick look, List links and controls, which the browser code reads
allow ^month \{month\} of \{year\} has \{\} days$   # a refused date's diagnostic for a console's log; a reader sees the catalog's words

# The gallery: the synthetic data it draws, and its server.
skip app/ferrohealth-ui-gallery/src/clinical_data.rs  # the synthetic record the clinical record parts draw as data
skip app/ferrohealth-ui-gallery/src/data.rs     # the synthetic rows and documents the gallery draws as data
skip app/ferrohealth-ui-gallery/src/records_data.rs  # the synthetic people, records and identifiers the record components draw as data
skip app/ferrohealth-ui-gallery/src/terminology_data.rs  # the synthetic codes, displays, roots and mappings the terminology parts draw as data
skip app/ferrohealth-ui-gallery/src/trees_data.rs  # the synthetic code systems, directory and template the trees draw as data
skip app/ferrohealth-ui-gallery/src/server.rs   # the HTTP server: headers, policies, environment names, a malformed post's refusal
allow ^SYN-[0-9]+$                      # the gallery's synthetic codes
allow ^synthetic-node-[a-z]$            # a synthetic node's name, drawn as code
allow ^https?://                        # a URL
allow ^/[a-z_/]+$                       # a path, drawn as code
allow ^Practitioner/                    # a FHIR reference, the synthetic operator's
allow ^file-L$                          # an editor line's id prefix
allow ^(#\{MAPPING_DRAFT\}|code#file)-L$   # a diagnostic's link to a line, before its number
allow ^[0-9]{4}-[0-9]{2}-[0-9]{2}T      # an RFC 3339 instant, drawn as data
allow ^2026-10-1\{index\}T              # the same, made per row
allow ^[0-9a-f]{8}-[0-9a-f-]+           # an identifier in the UUID form
allow ^0123456789ab$                    # a synthetic version hash
allow ^CARGO_PKG_VERSION$               # the environment variable Cargo sets
allow ^(GET|POST)$                      # an HTTP method
allow ^theme=\{\}&back=                 # a form body the theme toggle posts
allow ^fhirUser$                      # a SMART App Launch scope token the scope parser matches; a reader sees the catalog's words
allow ^main h1$                          # the CSS selector of the page heading the announcer focuses, which the browser code reads
