# The English words of the tables, the pagers and the change table: one
# message per `Text` of `src/i18n/words/tables.rs`, in the order of their ids.

change-added = added
change-after = After
change-before = Before
change-none = Nothing changes.
change-not-set = not set
change-removed = removed
change-setting = Setting
open-range-of = { $nouns } { $first } to { $last }
open-range-past = Page { $page } is past the last { $noun }.
page-of = Page { $page } of { $pages }
partial-note = The server counted { $stated } { $noun }, and this listing holds { $held }.
range = { $first }-{ $last } of { $total }
range-empty = No rows
range-of = { $first }-{ $last } of { $total } { $noun }
range-with-note = { $range }. { $note }
rows =
    { $count ->
        [one] row
       *[other] rows
    }
rows-opening = Rows
rows-per-page = Rows per page
step-first = First
step-last = Last
step-next = Next
step-previous = Previous
step-unavailable = (unavailable)
