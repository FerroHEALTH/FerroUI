# The English words of the trees and the path browser: one message per
# `Text` of `src/i18n/words/trees.rs`, in the order of their ids.

path-node-flat = FLAT path
path-node-occurrences = Occurrences
path-node-path = Path
path-node-query = Build a query on this path
path-node-rm-type = RM type
path-node-units = Units
path-node-value-set = { $count ->
    [one] Value set · { $count } code
   *[other] Value set · { $count } codes
}
tree-collapse = Collapse { $label }
tree-edit-add-folder = Add a folder in { $label }
tree-edit-add-reference = Add a reference in { $label }
tree-edit-remove = Remove { $label }
tree-edit-remove-reference = Remove the reference { $label }
tree-edit-rename = Rename { $label }
tree-edit-undo = Undo removing { $label }
tree-expand = Expand { $label }
tree-inactive = Inactive
tree-more = { $shown } of { $total } children shown.
tree-more-next = Show the next { $count }
tree-more-rest = { $count ->
    [one] Show the other one
   *[other] Show the other { $count }
}
tree-reading = Reading the children
tree-removed = (removed)
tree-rename-field = New name for { $label }
