# The English words of the buttons, dialogs, toasts, tabs, menus and selects:
# one message per `Text` of `src/i18n/words/controls.rs`, in the order of
# their ids.

cancel = Cancel
combobox-more = More options match than the list shows: type to narrow it.
combobox-no-match = No match
help-show = Explain these parameters
hold-show = Show the text while held
hold-show-needs-script = The text stays masked: showing it works once the page has loaded
menu-more = More
