select-name = { $label }: { $value }
tab-draft = draft
tab-draft-choice = { $tab } (draft)
tab-go = Go
toast-dismiss = Dismiss
toast-region = Notices
variant-danger = Danger
variant-destructive = Destructive
variant-ghost = Ghost
variant-primary = Primary
variant-secondary = Secondary
