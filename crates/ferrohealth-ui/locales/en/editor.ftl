# The English words of the code editor's toolbar and status line: one
# message per `Text` of `src/i18n/words/editor.rs`, in the order of their ids.

editor-changed = Changed since opened
editor-error-on = Line { $line } has an error.
editor-new = New file
editor-position = Ln { $line }, Col { $column }
editor-unchanged = Unchanged
editor-warning-on = Line { $line } has a warning.
