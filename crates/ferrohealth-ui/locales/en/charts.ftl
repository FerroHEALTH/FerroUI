# The English words of the charts: one message per `Text` of
# `src/i18n/words/charts.rs`, in the order of their ids.

chart-as-table = { $chart }, as a table
chart-no-value = No value
chart-no-value-cell = no value
chart-series = Series
chart-x = X
flow-card = { $title }, { $note }: { $status }. Opens its page.
flow-edge = { $from } to { $to }: { $status }
flow-edge-noted = { $from } to { $to }: { $status }, { $note }
flow-fold = Fold the quiet cards of { $title }
flow-fold-card = { $count } more in { $title }: { $note }. Shows every card.
flow-fold-count = { $status } { $count }
flow-fold-join = { $first } · { $last }
flow-fold-name = { $count } more
flow-hub = { $title }, { $note }. Opens its page.
flow-state-degraded = Degraded
flow-state-not-checked = Not checked
flow-state-off = Off
flow-state-unreachable = Unreachable
flow-state-up = Up
flow-steady = No edge is degraded or unreachable.
flow-unfold = Show every card of { $title }
score-contribution = { $title } { $value }
score-name = Score { $value }, { $status }, on the scale: { $range }. { $summary }.
score-threshold = { $title } from { $value }
score-total-weight = Total weight
score-word = Score
